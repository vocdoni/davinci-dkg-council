{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@vocdoni/davinci-dkg-council-sdk": ["../sdk/src/index.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "vitest.config.ts", "../sdk/src/snarkjs.d.ts"]
}
